{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts --production",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:member-account": "tsx scripts/member-account.ts",
    "test": "node --import tsx --test tests/finance.test.ts tests/database.test.ts tests/manual-core.test.ts tests/whatsapp.test.ts tests/whatsapp-conversation.test.ts tests/auth.test.ts tests/accounts.test.ts tests/roles.test.ts tests/budgets.test.ts tests/fixed.test.ts tests/bot-queries.test.ts tests/control.test.ts tests/control-bot.test.ts tests/documents-unit.test.ts tests/documents.test.ts tests/focus.test.ts",
    "test:browser": "node --import tsx --test tests/database-browser.test.ts tests/manual-core-browser.test.ts tests/accounts-browser.test.ts",
    "test:legacy-browser": "tsx scripts/test-legacy-browser.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
