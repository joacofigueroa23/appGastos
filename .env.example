# Copiar a .env (junto a package.json) y completar. Nunca commitear .env.
PORT=3000
DATABASE_URL=postgresql://USUARIO:CONTRASENA_URL_ENCODED@HOST:5432/postgres
APP_FAMILY_ID=00000000-0000-4000-8000-000000000001
# Opcional: certificado raíz de Supabase para verificar TLS.
# DATABASE_CA_FILE=prod-ca-2021.crt

# Gemini (solo backend). Lista separada por comas: ante 503/429/timeout se prueba el siguiente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# WhatsApp Cloud API (ver docs/whatsapp.md)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
APP_URL=https://tu-url-publica
# APP_TIME_ZONE=America/Argentina/Buenos_Aires
# WHATSAPP_GRAPH_VERSION=v21.0
# Minutos sin mensajes válidos para que venza una conversación pendiente (1..1440, por defecto 30).
# WHATSAPP_CONVERSATION_TTL_MINUTES=30
